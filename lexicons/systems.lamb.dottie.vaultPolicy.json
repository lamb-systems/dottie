{
  "lexicon": 1,
  "id": "systems.lamb.dottie.vaultPolicy",
  "defs": {
    "main": {
      "type": "record",
      "description": "The signed V02 policy object. V02 uint64 values are represented as Lexicon integers bounded by 9007199254740991 (2^53-1); the encoder rejects larger values. The recipients array is bounded to 64; device and key identifiers are limited to 255 bytes; every administrative V02 object is limited to 65536 bytes inclusive. Ed25519 signing-key authorization comes from the certificate chain and policy role, while the policy binds each recipient X25519 public key by value.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "schemaVersion",
          "vault",
          "epochSeq",
          "roles",
          "recipients",
          "policyRetentionFloor",
          "retainedRecoveryPoints",
          "maxPublications",
          "maxEpochAge",
          "recoveryAnchor",
          "prevPolicyDigest",
          "signerDeviceId",
          "signerKeyId",
          "signature"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "vault": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "epochSeq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "roles": {
            "type": "array",
            "maxLength": 65535,
            "items": {
              "type": "object",
              "required": [
                "deviceId",
                "role"
              ],
              "properties": {
                "deviceId": {
                  "type": "string",
                  "maxLength": 255
                },
                "role": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                }
              }
            }
          },
          "recipients": {
            "type": "array",
            "maxLength": 64,
            "items": {
              "type": "object",
              "required": [
                "deviceId",
                "keyId",
                "publicKey"
              ],
              "properties": {
                "deviceId": {
                  "type": "string",
                  "maxLength": 255
                },
                "keyId": {
                  "type": "bytes",
                  "maxLength": 255,
                  "description": "X25519 wrapping-key identifier; distinct from a certificate keyId, which identifies an Ed25519 signing key."
                },
                "publicKey": {
                  "type": "bytes",
                  "minLength": 32,
                  "maxLength": 32
                }
              }
            }
          },
          "policyRetentionFloor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "retainedRecoveryPoints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "maxPublications": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "maxEpochAge": {
            "type": "integer",
            "minimum": 3600,
            "maximum": 31536000
          },
          "recoveryAnchor": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "prevPolicyDigest": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "signerDeviceId": {
            "type": "string",
            "maxLength": 255
          },
          "signerKeyId": {
            "type": "bytes",
            "maxLength": 255
          },
          "signature": {
            "type": "bytes",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  }
}
