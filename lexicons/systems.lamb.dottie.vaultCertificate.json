{
  "lexicon": 1,
  "id": "systems.lamb.dottie.vaultCertificate",
  "defs": {
    "main": {
      "type": "record",
      "description": "The signed V02 device certificate. V02 uint64 values are represented as Lexicon integers bounded by 9007199254740991 (2^53-1); the encoder rejects larger values. CIDs and revocation references are raw CID bytes and are limited to 128 bytes inclusive. Device and key identifiers are limited to 255 bytes; every administrative V02 object is limited to 65536 bytes inclusive. The record binds both public keys to the signed certificate object; policy context binds the role and X25519 recipient key, and certificate-chain verification authenticates the Ed25519 signing key.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "schemaVersion",
          "vault",
          "deviceId",
          "keyId",
          "signingPublicKey",
          "encryptionPublicKey",
          "role",
          "certEpoch",
          "issuer",
          "revocationRef",
          "signerDeviceId",
          "signerKeyId",
          "signature"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "vault": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "deviceId": {
            "type": "string",
            "maxLength": 255
          },
          "keyId": {
            "type": "bytes",
            "maxLength": 255,
            "description": "Ed25519 signing-key identifier; distinct from a policy recipient keyId, which identifies an X25519 wrapping key."
          },
          "signingPublicKey": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "encryptionPublicKey": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "role": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "certEpoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "issuer": {
            "type": "string",
            "maxLength": 255
          },
          "revocationRef": {
            "type": "bytes",
            "maxLength": 128
          },
          "signerDeviceId": {
            "type": "string",
            "maxLength": 255
          },
          "signerKeyId": {
            "type": "bytes",
            "maxLength": 255
          },
          "signature": {
            "type": "bytes",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  }
}
