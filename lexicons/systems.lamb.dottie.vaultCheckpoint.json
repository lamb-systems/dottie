{
  "lexicon": 1,
  "id": "systems.lamb.dottie.vaultCheckpoint",
  "defs": {
    "main": {
      "type": "record",
      "description": "The signed V02 checkpoint object. V02 uint64 values are represented as Lexicon integers bounded by 9007199254740991 (2^53-1); the encoder rejects larger values. CIDs are raw CID bytes and are limited to 128 bytes inclusive. Every administrative V02 object is limited to 65536 bytes inclusive; a nonzero anchor must match the verifier-supplied root fingerprint.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "schemaVersion",
          "vault",
          "snapshotCid",
          "epochSeq",
          "policyDigest",
          "anchor",
          "controlCid",
          "signerDeviceId",
          "signerKeyId",
          "signature"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "vault": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "snapshotCid": {
            "type": "bytes",
            "maxLength": 128
          },
          "epochSeq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "policyDigest": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "anchor": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "controlCid": {
            "type": "bytes",
            "maxLength": 128
          },
          "signerDeviceId": {
            "type": "string",
            "maxLength": 255
          },
          "signerKeyId": {
            "type": "bytes",
            "maxLength": 255
          },
          "signature": {
            "type": "bytes",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  }
}
