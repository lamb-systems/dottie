{
  "lexicon": 1,
  "id": "systems.lamb.dottie.vaultHead",
  "defs": {
    "main": {
      "type": "record",
      "description": "The signed current head object. Record publicationCount must equal the signed V02 head value; deciding whether the count should be zero at enrollment or predecessor count plus one belongs to transition validation. V02 uint64 values are represented as Lexicon integers bounded by 9007199254740991 (2^53-1); the encoder rejects larger values. CIDs are raw CID bytes and are limited to 128 bytes inclusive. Every administrative V02 object is limited to 65536 bytes inclusive.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "schemaVersion",
          "vault",
          "epochSeq",
          "policyDigest",
          "snapshotCid",
          "blobCid",
          "publicationCount",
          "prevHeadCid",
          "signerDeviceId",
          "signerKeyId",
          "signature"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "vault": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "epochSeq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "policyDigest": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "snapshotCid": {
            "type": "bytes",
            "maxLength": 128
          },
          "blobCid": {
            "type": "bytes",
            "maxLength": 128
          },
          "publicationCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "prevHeadCid": {
            "type": "bytes",
            "maxLength": 128
          },
          "signerDeviceId": {
            "type": "string",
            "maxLength": 255
          },
          "signerKeyId": {
            "type": "bytes",
            "maxLength": 255
          },
          "signature": {
            "type": "bytes",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  }
}
