{
  "lexicon": 1,
  "id": "systems.lamb.dottie.vaultControl",
  "defs": {
    "main": {
      "type": "record",
      "description": "The signed root-authorized control object. V02 uint64 values are represented as Lexicon integers bounded by 9007199254740991 (2^53-1); the encoder rejects larger values. CIDs are raw CID bytes and are limited to 128 bytes inclusive. Device identifiers are limited to 255 UTF-8 bytes, and every administrative V02 object is limited to 65536 bytes inclusive.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "schemaVersion",
          "vault",
          "epochSeq",
          "policyDigest",
          "headSnapshotCid",
          "revoked",
          "prevControlCid",
          "signerDeviceId",
          "signerKeyId",
          "signature"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "vault": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "epochSeq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "policyDigest": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "headSnapshotCid": {
            "type": "bytes",
            "maxLength": 128
          },
          "revoked": {
            "type": "array",
            "maxLength": 65535,
            "items": {
              "type": "object",
              "required": [
                "deviceId",
                "certEpoch"
              ],
              "properties": {
                "deviceId": {
                  "type": "string",
                  "maxLength": 255
                },
                "certEpoch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          },
          "prevControlCid": {
            "type": "bytes",
            "maxLength": 128
          },
          "signerDeviceId": {
            "type": "string",
            "maxLength": 255
          },
          "signerKeyId": {
            "type": "bytes",
            "maxLength": 255
          },
          "signature": {
            "type": "bytes",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  }
}
