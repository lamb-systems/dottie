{
  "lexicon": 1,
  "id": "systems.lamb.dottie.vaultSnapshotV2",
  "defs": {
    "main": {
      "type": "record",
      "description": "A v2 publication pointer to exactly one plaintext snapshot payload, carried as an ordered list of payload segments, one per target, sorted by target id. Each segment names its target and one form. The entries form carries one file-level blob per regular file, with paths of at most 1024 bytes that are relative, contain no empty, `.` or `..` segment, are unique within the segment and appear in ascending order; entry modes are limited to 0600 and 0644, and a file-kind target root carries exactly one entry whose path is the root basename. The settings form carries typed GNOME settings inline, sorted by schema id, settings path and key, with a value exactly when the state is present, for a settings target without a filesystem root. The packed form carries one USTAR blob for a target the other forms cannot represent. A record carries at most 256 segments and at most 64 entries per entries segment. Records use sequence keys of exactly 16 zero-padded ASCII decimal digits. Record CID and raw payload CIDs are distinct roles.",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "schemaVersion",
          "vault",
          "publicationId",
          "publicationSeq",
          "parent",
          "segments"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 2
          },
          "vault": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "publicationId": {
            "type": "bytes",
            "minLength": 16,
            "maxLength": 16
          },
          "publicationSeq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "parent": {
            "type": "bytes",
            "maxLength": 128
          },
          "segments": {
            "type": "array",
            "minLength": 1,
            "maxLength": 256,
            "items": {
              "type": "object",
              "required": [
                "target",
                "form"
              ],
              "properties": {
                "target": {
                  "type": "object",
                  "required": [
                    "id",
                    "source",
                    "source_version"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "files",
                        "gnome"
                      ]
                    },
                    "source_version": {
                      "type": "integer",
                      "const": 1
                    },
                    "root": {
                      "type": "object",
                      "required": [
                        "base",
                        "path",
                        "kind"
                      ],
                      "properties": {
                        "base": {
                          "type": "string",
                          "enum": [
                            "home",
                            "xdg-config"
                          ]
                        },
                        "path": {
                          "type": "string",
                          "maxLength": 4096
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "file",
                            "directory"
                          ]
                        }
                      }
                    }
                  }
                },
                "form": {
                  "type": "string",
                  "enum": [
                    "entries",
                    "settings",
                    "packed"
                  ]
                },
                "entries": {
                  "type": "array",
                  "maxLength": 64,
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "mode",
                      "size",
                      "kind",
                      "blob"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "maxLength": 1024
                      },
                      "mode": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 511
                      },
                      "size": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 402653184
                      },
                      "kind": {
                        "type": "string",
                        "const": "file"
                      },
                      "blob": {
                        "type": "blob",
                        "accept": [
                          "application/octet-stream",
                          "application/x-tar"
                        ],
                        "maxSize": 402653184
                      }
                    }
                  }
                },
                "settings": {
                  "type": "array",
                  "maxLength": 256,
                  "items": {
                    "type": "object",
                    "required": [
                      "schemaId",
                      "path",
                      "key",
                      "state"
                    ],
                    "properties": {
                      "schemaId": {
                        "type": "string",
                        "maxLength": 255
                      },
                      "path": {
                        "type": "string",
                        "maxLength": 4096
                      },
                      "key": {
                        "type": "string",
                        "maxLength": 255
                      },
                      "state": {
                        "type": "string",
                        "enum": [
                          "present",
                          "reset"
                        ]
                      },
                      "value": {
                        "type": "object",
                        "required": [
                          "type",
                          "text"
                        ],
                        "properties": {
                          "type": {
                            "type": "string",
                            "maxLength": 255
                          },
                          "text": {
                            "type": "string",
                            "maxLength": 65536
                          }
                        }
                      }
                    }
                  }
                },
                "blob": {
                  "type": "blob",
                  "accept": [
                    "application/x-tar"
                  ],
                  "maxSize": 402653184
                }
              }
            }
          }
        }
      }
    }
  }
}
