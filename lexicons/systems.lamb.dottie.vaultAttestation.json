{
  "lexicon": 1,
  "id": "systems.lamb.dottie.vaultAttestation",
  "defs": {
    "main": {
      "type": "record",
      "description": "The device-signed V02 retention attestation. Schema version 1 is count-only and remains readable. Schema version 2 includes an ordered recoveryPoints list of epoch and snapshotCid pairs; the retainedRecoveryPoints count must equal the list length. Recovery points are ordered by epoch and then snapshotCid bytes, with duplicates rejected. V02 uint64 values are represented as Lexicon integers bounded by 9007199254740991 (2^53-1); the encoder rejects larger values. The control reference and each snapshot CID are raw CID bytes limited to 128 bytes inclusive. Device and key identifiers are limited to 255 bytes; every administrative V02 object is limited to 65536 bytes inclusive. Context verification binds the attestation to the authenticated vault, policy and control.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "schemaVersion",
          "vault",
          "deviceId",
          "policyDigest",
          "retentionFloor",
          "retainedRecoveryPoints",
          "controlCid",
          "signerDeviceId",
          "signerKeyId",
          "signature"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "vault": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "deviceId": {
            "type": "string",
            "maxLength": 255
          },
          "policyDigest": {
            "type": "bytes",
            "minLength": 32,
            "maxLength": 32
          },
          "retentionFloor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "retainedRecoveryPoints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "recoveryPoints": {
            "type": "array",
            "maxLength": 65535,
            "items": {
              "type": "object",
              "required": [
                "epoch",
                "snapshotCid"
              ],
              "properties": {
                "epoch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "snapshotCid": {
                  "type": "bytes",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          },
          "controlCid": {
            "type": "bytes",
            "maxLength": 128
          },
          "signerDeviceId": {
            "type": "string",
            "maxLength": 255
          },
          "signerKeyId": {
            "type": "bytes",
            "maxLength": 255
          },
          "signature": {
            "type": "bytes",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  }
}
